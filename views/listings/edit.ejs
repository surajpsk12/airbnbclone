<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2">
    <h3>Edit Your Listing</h3>
    <form action="/listings/<%= listing._id %>?_method=PUT" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label " for="title">Title:</label>
            <input type="text" id="title" class="form-control" name="listing[title]" value="<%= listing.title %>" required>
            <div class="invalid-feedback">
                Enter a valid title.
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="description">Description:</label><br>
            <textarea id="description" class="form-control" name="listing[description]" rows="2" cols="10" required><%= listing.description %></textarea>
            <div class="invalid-feedback">
                Enter a valid description.
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="currentImage">Current Image:</label><br>
            <img src="<%= originalImageUrl %>" alt="Current Listing Image" class="img-thumbnail" style="max-width: 300px;">
        </div>

        <div class="mb-3">
            <label class="form-label" for="imageUrl">Upload New Image:</label>
            <input type="file" id="imageUrl" class="form-control" name="listing[image]"  />
            
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
                <label class="form-label" for="price">Price:</label>
                <input type="number" id="price" class="form-control" name="listing[price]" value="<%= listing.price %>" required>
                <div class="invalid-feedback">
                    Enter a valid price.
                </div>
            </div>
            <div class="mb-3 col-md-8">
                <label class="form-label" for="country" >Country:</label>
                <input type="text" id="country" class="form-control" name="listing[country]" value="<%= listing.country %>" required>
                <div class="invalid-feedback">
                    Enter a valid country.
                </div>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="location">Location:</label>
            <input type="text" id="location" class="form-control" name="listing[location]" value="<%= listing.location %>" required>
            <div class="invalid-feedback">
                Enter a valid location.
            </div>
        </div>

        
        <button class="btn btn-dark edit-btn mt-3 mb-3" type="submit">Edit</button>
    </form>
    </div>
</div>  