<% layout("/layouts/boilerplate") %>
<body>
    <!-- <h3>All listings </h3> -->
    <!-- <form action="/listing/new" method="get">
        <button type="submit">Create New Listing</button>
    </form> -->

    <style>
        #filters{
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .filter{
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            padding: 0.1rem 2rem;
            border-radius: 0.5rem;
            background-color: #f8f9fa;
            cursor: pointer;
            transition: background-color 0.3s ease;
            opacity: 0.7;
        } 
 
        .filter:hover{
            background-color: #e9ecef;
            opacity: 1;
        }

        .filter p {
            font-size: 0.8rem;
        }

    </style>

    <div id="filters">
        <div class="filter">
            <div class=""><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div class=""><i class="fa-solid fa-bed"></i></div>
            <p>Bed & Breakfast</p>
        </div>
       
        <div class="filter">
            <div class=""><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
        </div>
        <div class="filter">
            <div class=""><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <div class=""><i class="fa-solid fa-fort-awesome"></i></div>
            <p>Castles</p>
        </div>
        <div class="filter">
            <div class=""><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </div>
        <div class="filter">
            <div class=""><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </div>
        <div class="filter">
            <div class=""><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </div>
        <div class="filter">
            <div class=""><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
        </div>
    </div>


<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mt-3">
  <%for ( let listing of allListings){%>
  <a href="/listings/<%=listing._id%>" class="listing-link">
    <div class="card col listing-card">
      <img src="<%= listing.image.url %>" class="card-img-top" alt="card image" style="height: 20rem">
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-text">
        <h5 class="card-title"><%= listing.title %></h5>
        <br>
        &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
        <br>

        </p>
      </div>
    </div>
  </a>
  <%  }%>
</div>
</body>
