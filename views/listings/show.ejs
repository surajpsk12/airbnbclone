<% layout("/layouts/boilerplate") %>
<div class="row mt-3">

    <div class="col-8 offset-3">
         <h3><b><%= listing.title  %></b> <br></h3>
    </div>

    <div class="card col-6 offset-3 show-card listing-card">
        <img src="<%= listing.image %>" alt="listing image" class="card-img-top show-img">
        <div class="card-body">
            <p class="card-text">Owned by <i><%= listing.owner ? listing.owner.username : "Unknown user" %></i></p>
            <p class="card-text"><%= listing.description %></p>
            <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN") %> per night</p>
            <p class="card-text"><%= listing.location %> </p>
            <p class="card-text">Country: <%= listing.country %></p>
            
        </div>
    </div>
    <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)){ %>
    <div class="btns mb-3">
        <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
            <button type="submit" class="btn btn-dark offset-5">Delete</button>
        </form>
    </div>
    <% } %>

    <% if(currUser) { %>
    <div class="col-8 offset-3 mt-3">
        <hr>
        <h4>Leave a Review</h4>
        <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation">
            <div class=" mb-3 mt-3">
                <label for="rating" class="form-label"></label>
                <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range"/>
            </div>
            <div class=" mb-3 mt-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea 
                class="form-control" 
                id="comment" 
                name="review[comment]" 
                rows="5"
                cols="30" 
                required></textarea>
                <div class="invalid-feedback">
                    Enter a valid comment.
                </div>
            </div>
            <button type="submit" class="btn btn-outline-dark mt-3 mb-3">Submit</button>
        </form>
        <hr>
        <h4>Reviews</h4>
        <% if(listing.reviews.length === 0){ %>
            <p>No reviews yet.</p>
        <% } else { %>
            <div class="row">
                <% for(let review of listing.reviews){ %>
                    <div class="card mb-3 col-5 ms-3">
                        <div class="card-body">
                            <h6 class="card-title mb-2 text-muted">@ <%= review.author.username  %></h6>
                            <h5 class="card-title">Rating: <%= review.rating %> / 5</h5>
                            <p class="card-text"><%= review.comment %></p>
                            <form class="mb-3"  action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                                <button type="submit" class="btn btn-sm btn-dark">Delete</button>
                            </form>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
    <% } %>


    </div>

</div>